[Unit]
Description=Proposal Engine FastAPI App
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/proposal-engine
EnvironmentFile=/home/ubuntu/proposal-engine/.env
ExecStart=/home/ubuntu/.local/bin/uvicorn app_v5:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
